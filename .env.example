# NitroCloud 部署配置（复制为 .env 后按需修改；.env 不提交，本模板提交）
# 未建 .env 时，docker-compose.yml 使用各变量「:」后的默认值，一条命令可直接拉起。

# ── MQTT Broker（EMQX 5.x；18083 为控制台端口）──
EMQX_NODE_COOKIE=nitrocloud
EMQX_DASHBOARD_PASSWORD=admin123456

# ── InfluxDB 2.x 初始化（首次启动生效；改动后需 docker compose down -v 重建卷）──
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123456
INFLUXDB_ORG=nitrocloud
INFLUXDB_BUCKET=nitrocloud
INFLUXDB_TOKEN=dev-token
INFLUXDB_RETENTION=30d

# ── 对外端口（仅改宿主侧映射，容器内部固定 5100 / 80）──
CENTER_PORT=5100
WEB_PORT=8088
